<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd agent for OUI-SPY Mesh. Replace /PATH/TO/ouispy-detector
     with where the repo lives, then see README "Start automatically". -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ouispy.mesh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/ouispy-detector/home-dashboard/.venv/bin/python3</string>
        <string>/PATH/TO/ouispy-detector/home-dashboard/ouispymesh.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/ouispy-detector/home-dashboard</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/ouispymesh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ouispymesh.log</string>
</dict>
</plist>
